<mxfile host="app.diagrams.net" type="device"><diagram id="c4-2-container.drawio" name="C4 Ebene 2 – Container: Binokel Score Tracker"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="C4 Ebene 2 – Container: Binokel Score Tracker" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Spieler:in&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Browser (Desktop/Mobil).&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="200" height="160" as="geometry"/></mxCell><mxCell id="c3" value="Binokel Score Tracker – eine VM (IONOS), eine Domain (ADR-008, ADR-010)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="320" y="60" width="1000" height="760" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Reverse Proxy, TLS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Terminiert HTTPS, liefert statische SPA aus, leitet /api/ und /health/ an Gunicorn (Unix-Socket).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="220" height="160" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Vue-SPA&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Vue 3, Pinia, Vite, TypeScript]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Läuft im Browser. Anschreibetabelle, Rundenformular, Spielende. Spiegelt Regelkonstanten für UX-Validierung.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="220" height="160" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Django-API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Python 3.14, Django, Gunicorn (3 Worker, systemd)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Funktionsbasierte JsonResponse-Views (ADR-005). Wertung, Validierung, Persistenz, Sieger/Abrechnung.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="260" height="160" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;SQLite-Datei&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[SQLite]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Spiele, Spieler, Runden, Gegenspieler-Zeilen. Pfad über DJANGO_DB_PATH, außerhalb des Repos.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="300" width="180" height="160" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;OpenAPI-Vertrag&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[frontend/openapi/binokel-api.v1.yaml]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Handgepflegter API-Vertrag; manueller Sync mit Views (kein Codegen).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="260" height="130" as="geometry"/></mxCell><mxCell id="c9" value="HTTPS" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="Liefert statische Dateien (dist/)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="fetch /api/... (JSON, Same-Origin)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="proxy_pass (Unix-Socket)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="Django ORM (SQL)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="beschreibt" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="beschreibt (types.ts von Hand)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c8" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>