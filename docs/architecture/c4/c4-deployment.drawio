<mxfile host="app.diagrams.net" type="device"><diagram id="c4-deployment.drawio" name="C4 Deployment – Entwicklung, CI/CD, Produktion"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="C4 Deployment – Entwicklung, CI/CD, Produktion" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Entwickler&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="180" height="150" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[CI/CD]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;CI: manage.py check, makemigrations --check, behave, Vitest, Playwright, shellcheck. CD: nach grünem CI auf main, Production-Environment.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="260" height="190" as="geometry"/></mxCell><mxCell id="c4" value="IONOS-VM (Linux, ADR-008/009 gehärtet)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="700" height="760" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[systemd]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;TLS (Certbot), statische SPA aus /opt/binokel/frontend, Proxy auf Unix-Socket.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="260" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Gunicorn + Django&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[systemd: binokel-tracker.service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;3 Worker, Logs /var/log/binokel/.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="360" width="260" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;SQLite-Datei&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[DJANGO_DB_PATH]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Außerhalb des Repo-Verzeichnisses.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="360" width="200" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Host-Härtung&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[ufw, fail2ban (sshd)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Internet-Baseline gemäß ADR-009; kein Web-Rate-Limiting.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="320" height="150" as="geometry"/></mxCell><mxCell id="c9" value="git push" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="SSH: dist/ ausliefern" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="SSH: Backend ausrollen, Restart" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="Unix-Socket" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="SQL" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#444444;fontColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>