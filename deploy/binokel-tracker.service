[Unit]
Description=Binokel Score Tracker – Django via Gunicorn
Documentation=https://github.com/LarsBerberich/Binokel_Score_Tracker_BDD
After=network.target

[Service]
Type=notify

# Betriebsbenutzer – darf NICHT root sein
User=binokel-app
Group=binokel-app

# Arbeitsverzeichnis = Django-Backend
WorkingDirectory=/opt/binokel/app/backend

# Django-Konfiguration über EnvironmentFile (nie im Service-File hart kodieren!)
Environment="DJANGO_SETTINGS_MODULE=binokel_tracker.settings"
# HOME auf das beschreibbare RuntimeDirectory setzen. binokel-app ist ein System-User
# ohne Home (--no-create-home); Gunicorn ≥26 legt jedoch einen Control-Socket unter
# $HOME an und scheitert sonst mit "[Errno 13] Permission denied: '/home/binokel-app'".
Environment="HOME=/run/binokel"
EnvironmentFile=/etc/binokel/env

# Prozessstart: Gunicorn mit UNIX-Socket (Nginx kommuniziert darüber)
ExecStart=/opt/binokel/app/backend/.venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/binokel/binokel.sock \
    --access-logfile /var/log/binokel/access.log \
    --error-logfile /var/log/binokel/error.log \
    --capture-output \
    binokel_tracker.wsgi:application

# Sauberes Reload ohne Downtime (SIGHUP sendet neuen Master-Prozess)
ExecReload=/bin/kill -s HUP $MAINPID

# Temporäres Verzeichnis für den UNIX-Socket
RuntimeDirectory=binokel
RuntimeDirectoryMode=0755

# Sicherheitshärtung
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
# Dateisystem read-only bis auf explizit freigegebene Schreibpfade. binokel-app
# schreibt nur die SQLite-DB (data) und Logs; /run/binokel (RuntimeDirectory) ist
# automatisch schreibbar. STATIC_DIR ist bewusst NICHT dabei (nur binokel-deploy
# schreibt Static via collectstatic — siehe setup-server.sh, Least Privilege).
ProtectSystem=strict
ReadWritePaths=/var/log/binokel /opt/binokel/data
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

KillMode=mixed
TimeoutStopSec=5

# Automatischer Neustart bei Absturz (nicht bei manuellem Stop)
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
